---
import type { BankAccount } from '../../domain/entities/BankAccount';
import type { SiteProfile } from '../../domain/entities/SiteProfile';

interface Props {
  site: SiteProfile;
  bankAccounts: readonly BankAccount[];
}

const { site, bankAccounts } = Astro.props;
---

<section class="cta-sec" id="donasi">
  <div class="cta-dots" aria-hidden="true"></div>
  <div class="wrap">
    <div class="cta-label">Mulai Berwakaf Hari Ini</div>
    <h2 class="cta-h2">Satu transfer. Jariyah <em>seumur hidup</em>.</h2>
    <p class="cta-sub">Transfer ke rekening di bawah, lalu konfirmasi via WhatsApp kami. Laporan lengkap dikirimkan saat sumur selesai dibangun.</p>
    <div class="cta-btns">
      <a class="btn-gold" href={site.donationUrl} target="_blank" rel="noopener">Donasi via Website →</a>
      <a class="btn-glass" href={site.whatsappUrl} target="_blank" rel="noopener">Konfirmasi WhatsApp</a>
    </div>
    <div class="cta-box">
      {
        bankAccounts.map((bank, i) => (
          <>
            {i > 0 && <div class="cta-divider" aria-hidden="true" />}
            <div>
              <div class="cta-bank-nm">{bank.bankName}</div>
              <div class="cta-bank-no">{bank.accountNumber}</div>
              <div class="cta-bank-own">a.n. {bank.accountHolder}</div>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
/* ── CTA DONASI ── */
.cta-sec {
  margin: 0 10px 52px;
  background: linear-gradient(140deg, #0A2E6E 0%, #1565C0 55%, #42A5F5 100%);
  border-radius: 20px; padding: 84px 0;
  text-align: center; color: #fff; position: relative; overflow: hidden;
}
.cta-dots {
  position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(255,255,255,.1) 1.5px, transparent 1.5px);
  background-size: 32px 32px;
}
.cta-sec .wrap { position: relative; z-index: 1; }
.cta-label {
  font-size: 11px; font-weight: 700; letter-spacing: .15em;
  text-transform: uppercase; color: var(--gold); margin-bottom: 14px;
}
.cta-h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(1.9rem, 5vw, 3.2rem);
  font-weight: 800; line-height: 1.1;
  color: #fff; margin: 0 auto 18px; max-width: 580px; text-wrap: balance;
}
.cta-h2 em { font-style: normal; color: var(--gold); }
.cta-sub {
  font-size: 15px; color: rgba(255,255,255,.72);
  max-width: 460px; margin: 0 auto 38px; line-height: 1.72;
}
.cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.cta-box {
  margin-top: 40px;
  display: inline-flex; align-items: center; gap: 24px; flex-wrap: wrap;
  justify-content: center;
  background: rgba(255,255,255,.1); backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 16px; padding: 24px 36px;
}
.cta-bank-nm {
  font-size: 11px; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: rgba(255,255,255,.45); margin-bottom: 4px;
}
.cta-bank-no {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.3rem; font-weight: 700; color: #fff;
  letter-spacing: .04em; font-variant-numeric: tabular-nums;
}
.cta-bank-own { font-size: 12px; color: rgba(255,255,255,.58); margin-top: 2px; }
.cta-divider { width: 1px; height: 56px; background: rgba(255,255,255,.18); }
@media (max-width: 600px) {
  .cta-sec { margin: 0 8px 36px; border-radius: 16px; }
  .cta-divider { width: 56px; height: 1px; }
}
</style>
