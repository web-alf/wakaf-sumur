---
import type { BankAccount } from '../../domain/entities/BankAccount';
import type { SiteProfile } from '../../domain/entities/SiteProfile';
import { buildWhatsAppUrl } from '../../domain/services/whatsapp';

interface Props {
  site: SiteProfile;
  bankAccounts: readonly BankAccount[];
}

const { site, bankAccounts } = Astro.props;

// Jika semua rekening atas nama yang sama, tampilkan satu kali saja.
const holders = new Set(bankAccounts.map((b) => b.accountHolder));
const sharedHolder = holders.size === 1 ? [...holders][0] : null;

const confirmUrl = buildWhatsAppUrl(site.whatsappNumber);
const contactUrl = buildWhatsAppUrl(site.whatsappNumber, site.whatsappGreetings.contact);
---

<section class="cta-sec" id="donasi">
  <div class="cta-dots" aria-hidden="true"></div>
  <div class="wrap">
    <div class="cta-label">Mulai Berwakaf Hari Ini</div>
    <h2 class="cta-h2">Satu transfer. Jariyah <em>seumur hidup</em>.</h2>
    <p class="cta-sub">Transfer ke rekening di bawah, lalu konfirmasi via WhatsApp kami. Laporan lengkap dikirimkan saat sumur selesai dibangun.</p>
    <div class="cta-btns">
      <a class="btn-gold" href={confirmUrl} target="_blank" rel="noopener">Konfirmasi WhatsApp</a>
    </div>
    <div class="cta-box">
      {sharedHolder && <div class="cta-holder">Semua rekening atas nama <strong>{sharedHolder}</strong></div>}
      <div class="cta-accounts">
        {
          bankAccounts.map((bank) => (
            <div class="cta-account">
              <div class="cta-bank-nm">{bank.bankName}</div>
              <div class="cta-no-row">
                <div class="cta-bank-no">{bank.accountNumber}</div>
                <button
                  type="button"
                  class="cta-copy"
                  data-copy={bank.accountNumber.replace(/\s+/g, '')}
                  data-copy-bank={bank.bankName}
                  aria-label={`Salin nomor rekening ${bank.bankName}`}
                  title="Salin nomor rekening"
                >
                  <svg class="ico-copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <svg class="ico-done" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </button>
              </div>
              {!sharedHolder && <div class="cta-bank-own">a.n. {bank.accountHolder}</div>}
            </div>
          ))
        }
      </div>
      <div class="sr-only" role="status" aria-live="polite" data-copy-status></div>
    </div>

    <div class="cta-contact" id="kontak">
      <h3 class="cta-contact-ttl">Kontak</h3>
      <p class="cta-contact-txt">Ada pertanyaan seputar wakaf sumur? Hubungi kami melalui WhatsApp.</p>
      <a class="btn-glass cta-contact-btn" href={contactUrl} target="_blank" rel="noopener">
        WhatsApp {site.whatsappDisplay}
      </a>
    </div>
  </div>
</section>

<style>
/* ── CTA DONASI ── */
.cta-sec {
  margin: 0 10px 52px;
  background: var(--grad-section);
  border-radius: 20px; padding: 84px 0;
  text-align: center; color: #fff; position: relative; overflow: hidden;
}
.cta-dots {
  position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(255,255,255,.1) 1.5px, transparent 1.5px);
  background-size: 32px 32px;
}
.cta-sec .wrap { position: relative; z-index: 1; }
.cta-label {
  font-size: 11px; font-weight: 700; letter-spacing: .15em;
  text-transform: uppercase; color: var(--gold); margin-bottom: 14px;
}
.cta-h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(1.9rem, 5vw, 3.2rem);
  font-weight: 800; line-height: 1.1;
  color: #fff; margin: 0 auto 18px; max-width: 580px; text-wrap: balance;
}
.cta-h2 em { font-style: normal; color: var(--gold); }
.cta-sub {
  font-size: 15px; color: rgba(255,255,255,.72);
  max-width: 460px; margin: 0 auto 38px; line-height: 1.72;
}
.cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.cta-contact {
  max-width: 880px; margin: 40px auto 0; padding-top: 36px;
  border-top: 1px solid rgba(255,255,255,.22);
  scroll-margin-top: 24px;
}
.cta-contact-ttl {
  font-family: 'Space Grotesk', sans-serif; font-size: 1.35rem; font-weight: 700;
  color: #fff; margin: 0 0 8px;
}
.cta-contact-txt { font-size: 15px; color: rgba(255,255,255,.85); margin: 0 0 20px; }
.cta-contact-btn { justify-content: center; min-height: 48px; }
@media (max-width: 600px) {
  .cta-contact { margin-top: 28px; padding-top: 28px; }
  .cta-contact-txt { font-size: 16px; }
  .cta-contact-btn { display: flex; }
}
.cta-box {
  margin: 40px auto 0;
  max-width: 880px;
  background: rgba(255,255,255,.82);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  backdrop-filter: blur(16px) saturate(140%);
  border: 1px solid rgba(255,255,255,.6);
  box-shadow: 0 8px 32px rgba(10,35,64,.18);
  border-radius: 16px; padding: 28px 28px 30px;
  text-align: center; color: #000;
}
.cta-holder {
  font-size: 13px; color: #000;
  padding-bottom: 20px; margin-bottom: 22px;
  border-bottom: 1px solid rgba(0,0,0,.12);
  text-transform: uppercase; letter-spacing: .04em;
}
.cta-holder strong { color: #000; }
.cta-accounts {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: 24px 20px;
}
.cta-account { flex: 0 1 252px; min-width: 0; text-align: center; }
.cta-bank-nm {
  font-size: 11px; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: #000; margin-bottom: 4px;
}
.cta-bank-no {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.3rem; font-weight: 700; color: #000;
  letter-spacing: .04em; font-variant-numeric: tabular-nums;
}
.cta-bank-own { font-size: 12px; color: #000; margin-top: 2px; }
.cta-no-row {
  display: flex; align-items: center; justify-content: center;
  flex-wrap: wrap; gap: 4px 8px;
}
/* Ikon saja; area ketuk 44px dengan tampilan visual 36px */
.cta-copy {
  position: relative; flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; padding: 0;
  color: var(--blue-dk); background: #fff;
  border: 1.5px solid var(--blue); border-radius: var(--radius-btn);
  cursor: pointer; transition: background .2s, color .2s, border-color .2s;
}
.cta-copy::after { content: ''; position: absolute; inset: -4px; }
.cta-copy:hover { background: var(--blue); color: #fff; }
.cta-copy:focus-visible { outline: 3px solid var(--blue-dep); outline-offset: 2px; }
.cta-copy .ico-done { display: none; }
.cta-copy.is-copied { background: var(--green); border-color: var(--green); color: #fff; }
.cta-copy.is-copied .ico-copy { display: none; }
.cta-copy.is-copied .ico-done { display: block; }
.cta-copy.is-failed { background: #fff; border-color: #B3261E; color: #B3261E; }
@media (max-width: 600px) {
  .cta-sec { margin: 0 8px 36px; border-radius: 16px; }
  .cta-box { padding: 22px 20px 24px; }
}
@media (max-width: 600px) {
  .cta-sec { padding: 52px 0; }
  .cta-sub { font-size: 16px; margin-bottom: 28px; }
  .cta-btns { flex-direction: column; align-items: stretch; }
  .cta-btns > a { justify-content: center; min-height: 48px; }
  .cta-box { margin-top: 28px; }
  .cta-accounts { flex-direction: column; flex-wrap: nowrap; gap: 0; }
  .cta-account {
    flex: none; width: 100%;
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "nm copy" "no copy" "own copy";
    align-items: center; column-gap: 12px;
    text-align: left; padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, .1);
  }
  .cta-account:last-child { border-bottom: 0; padding-bottom: 0; }
  .cta-no-row { display: contents; }
  .cta-bank-nm { grid-area: nm; margin: 0; }
  .cta-bank-no { grid-area: no; font-size: 1.2rem; }
  .cta-bank-own { grid-area: own; }
  .cta-copy { grid-area: copy; width: 44px; height: 44px; }
}
</style>
