---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const titleId = `${id}-title`;
---

<div class="modal-overlay" id={id}>
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby={titleId}>
    <div class="modal-head">
      <span class="modal-title" id={titleId}>{title}</span>
      <button class="modal-close" type="button" data-modal-close aria-label="Tutup">✕</button>
    </div>
    <div class="modal-body">
      <slot />
    </div>
  </div>
</div>

<style is:global>
/* ── MODAL ── */
.modal-overlay {
  display: none; position: fixed; inset: 0; z-index: 1000;
  background: rgba(0,0,0,.55); backdrop-filter: blur(4px);
  align-items: center; justify-content: center; padding: 20px;
}
.modal-overlay.open { display: flex; }
.modal-box {
  background: #fff; color: #0A2340;
  border-radius: 20px; max-width: 680px; width: 100%;
  max-height: 85vh; overflow-y: auto;
  box-shadow: 0 24px 80px rgba(0,0,0,.3);
  animation: modalIn .22s ease;
}
@keyframes modalIn { from { opacity:0; transform:scale(.96) translateY(12px); } to { opacity:1; transform:none; } }
.modal-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24px 28px 18px; border-bottom: 1px solid #BBDEFB; position: sticky; top:0; background:#fff; z-index:1;
}
.modal-title { font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:18px; color:#0A2340; }
.modal-close {
  width:34px; height:34px; border-radius:50%; border:none; cursor:pointer;
  background:#EEF4FF; color:#1565C0; font-size:18px; display:flex; align-items:center; justify-content:center;
  transition:background .2s;
}
.modal-close:hover { background:#BBDEFB; }
.modal-body { padding: 24px 28px 32px; }
.modal-body h3 { font-family:'Space Grotesk',sans-serif; font-size:15px; font-weight:700; color:#1565C0; margin:0 0 8px; }
.modal-body p  { font-size:14px; line-height:1.72; color:#1A4780; margin:0 0 18px; }
.modal-body ul { font-size:14px; line-height:1.72; color:#1A4780; margin:0 0 18px; padding-left:20px; }
.modal-body ul li { margin-bottom:6px; }
.modal-section { margin-bottom:28px; }
.modal-section:last-child { margin-bottom:0; }
.faq-q { font-weight:700; color:#0A2340; margin-bottom:4px; cursor:pointer; display:flex; justify-content:space-between; gap:12px; }
.faq-a { display:none; }
.faq-item.open .faq-a { display:block; }
.faq-toggle { flex-shrink:0; color:#1565C0; }
</style>
