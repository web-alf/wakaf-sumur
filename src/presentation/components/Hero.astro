<section class="hero">
  <div class="hero-dots"></div>
  <svg class="hero-wave" viewBox="0 0 1200 72" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M0 40 C200 70 400 10 600 40 C800 70 1000 10 1200 40 L1200 72 L0 72Z" fill="#FFFFFF" opacity=".92"/>
    <path d="M0 55 C300 30 600 72 900 50 C1050 38 1150 60 1200 55 L1200 72 L0 72Z" fill="#FFFFFF"/>
  </svg>
  <div class="hero-content wrap" style="padding-top:80px;padding-bottom:88px;">
    <div class="hero-left">
      <div class="hero-eyebrow">Wakaf Sumur Air Bersih — Indonesia</div>
      <h1 class="hero-h1">Satu sumur,<br /><em>ribuan</em><br />berkah mengalir.</h1>
      <p class="hero-desc">
        Di banyak desa terpencil, air bersih adalah kemewahan.
        Melalui wakaf sumur, <strong>donasi Anda mengalir abadi</strong>{' '}
        menyejukkan ribuan jiwa di pelosok negeri.
      </p>
      <div class="hero-btns">
        <a class="btn-gold" href="#donasi">Wakafkan Sekarang →</a>
        <a class="btn-glass" href="#program">Lihat Program</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <svg width="260" height="260" viewBox="0 0 260 260" xmlns="http://www.w3.org/2000/svg">
        <circle cx="130" cy="130" r="118" fill="rgba(255,255,255,.04)"/>
        <circle cx="130" cy="130" r="90"  fill="rgba(255,255,255,.04)"/>
        <ellipse cx="130" cy="174" rx="62" ry="10" fill="rgba(0,0,0,.28)"/>
        <rect x="82" y="118" width="96" height="72" rx="4" fill="#0A2E6E"/>
        <ellipse cx="130" cy="118" rx="48" ry="9" fill="#1565C0"/>
        <ellipse cx="130" cy="118" rx="34" ry="5.5" fill="#42A5F5" opacity=".75"/>
        <rect x="74" y="106" width="112" height="20" rx="8" fill="#0D47A1"/>
        <rect x="78" y="102" width="104" height="10" rx="5" fill="#1565C0"/>
        <rect x="82" y="52" width="11" height="56" rx="4" fill="#0D47A1"/>
        <rect x="167" y="52" width="11" height="56" rx="4" fill="#0D47A1"/>
        <rect x="77" y="50" width="106" height="13" rx="6.5" fill="#1565C0"/>
        <line x1="130" y1="63" x2="130" y2="104" stroke="rgba(253,216,53,.9)" stroke-width="2.5" stroke-dasharray="4 3"/>
        <rect x="118" y="75" width="24" height="20" rx="4" fill="#FDD835"/>
        <path d="M120 75 Q130 67 140 75" fill="none" stroke="#FDD835" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M72 54 L130 20 L188 54Z" fill="#42A5F5"/>
        <path d="M76 52 L130 24 L184 52Z" fill="#1565C0"/>
        <circle cx="52"  cy="78"  r="2.5" fill="rgba(245,195,37,.75)"/>
        <circle cx="210" cy="66"  r="2"   fill="rgba(245,195,37,.55)"/>
        <circle cx="44"  cy="136" r="1.5" fill="rgba(255,255,255,.4)"/>
        <circle cx="218" cy="124" r="1.5" fill="rgba(255,255,255,.4)"/>
        <ellipse cx="98"  cy="148" rx="3.5" ry="5.5" fill="#2BAFCF" opacity=".8"/>
        <ellipse cx="162" cy="143" rx="3"   ry="5"   fill="#2BAFCF" opacity=".6"/>
      </svg>
    </div>
  </div>
</section>

<style>
/* ── HERO ── */
.hero {
  margin: 10px 10px 0;
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(155deg, #0A2E6E 0%, #1565C0 48%, #42A5F5 100%);
  position: relative;
}
.hero-dots {
  position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(255,255,255,.12) 1px, transparent 1px);
  background-size: 36px 36px;
  opacity: .5;
}
.hero-wave {
  position: absolute; bottom: -1px; left: 0;
  /* SVG tidak melebar otomatis dengan left/right; wajib width eksplisit */
  width: 100%; height: 72px; display: block; pointer-events: none;
}
/* Ikuti warna latar halaman agar wave menyatu di mode terang & gelap */
.hero-wave path { fill: var(--bg); }
.hero-content {
  position: relative; z-index: 2;
  display: grid; grid-template-columns: 1fr auto;
  gap: 48px; align-items: center;
}
.hero-eyebrow {
  font-size: 11px; font-weight: 600; letter-spacing: .15em;
  text-transform: uppercase; color: rgba(255,255,255,.55);
  display: flex; align-items: center; gap: 10px; margin-bottom: 20px;
}
.hero-eyebrow::before {
  content: ''; display: block;
  width: 32px; height: 2px; background: var(--gold);
}
.hero-h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(2.1rem, 5vw, 3.8rem);
  font-weight: 800; line-height: 1.08;
  color: #fff; margin: 0 0 22px; text-wrap: balance;
}
.hero-h1 em { font-style: normal; color: var(--gold); }
.hero-desc {
  color: rgba(255,255,255,.78); font-size: 15px;
  line-height: 1.72; margin: 0 0 36px; max-width: 400px;
}
.hero-desc strong { color: #fff; font-weight: 600; }
.hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }

@media (max-width: 700px) {
  .hero { margin: 8px 8px 0; border-radius: 16px; }
  .hero-content { grid-template-columns: 1fr; }
  .hero-visual { display: none; }
}
</style>
