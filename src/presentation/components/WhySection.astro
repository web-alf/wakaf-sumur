---
import type { Reason } from '../../domain/entities/Reason';
import { reasonIconSvg } from '../lib/programPresentation';

interface Props {
  reasons: readonly Reason[];
}

const { reasons } = Astro.props;
---

<section class="why-sec r">
  <div class="wrap">
    <div class="why-eyebrow">02 / Mengapa Kami</div>
    <h2 class="why-h2">Mengapa berwakaf melalui <em>Wakaf Sumur</em>?</h2>
    <p class="why-sub">Karena amanah Anda bukan sekadar uang. Ini adalah aliran pahala yang tidak terputus, selama air itu terus mengalir.</p>
    <div class="why-cards">
      {
        reasons.map((reason, i) => (
          <div class="why-card">
            <div class="card-top">
              {String(i + 1).padStart(2, '0')}
              <div class="card-ico">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.8)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" set:html={reasonIconSvg[reason.icon]} />
              </div>
            </div>
            <h3>{reason.title}</h3>
            <p>{reason.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
/* ── WHY SECTION (blue) ── */
.why-sec {
  background: var(--blue);
  margin: 0 10px; border-radius: 20px;
  padding: 80px 0; color: #fff;
}
.why-eyebrow {
  font-size: 11px; font-weight: 600; letter-spacing: .15em;
  text-transform: uppercase; color: rgba(255,255,255,.45);
  display: flex; align-items: center; gap: 10px; margin-bottom: 18px;
}
.why-eyebrow::before { content: ''; display: block; width: 30px; height: 2px; background: var(--gold); }
.why-h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(1.75rem, 4vw, 2.9rem);
  font-weight: 800; line-height: 1.1;
  color: #fff; max-width: 520px; margin: 0 0 10px; text-wrap: balance;
}
.why-h2 em { font-style: normal; color: var(--gold); }
.why-sub { color: rgba(255,255,255,.62); font-size: 15px; max-width: 460px; margin: 0 0 52px; }
.why-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
.why-card {
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 16px; padding: 32px 26px;
  transition: background .2s;
}
.why-card:hover { background: rgba(255,255,255,.13); }
.card-top {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 11px; font-weight: 700; letter-spacing: .12em;
  text-transform: uppercase; color: rgba(255,255,255,.32);
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24px;
}
.card-ico {
  width: 30px; height: 30px; border-radius: 8px;
  background: rgba(255,255,255,.12);
  display: flex; align-items: center; justify-content: center;
}
.why-card h3 {
  font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem;
  font-weight: 700; color: #fff; margin: 0 0 10px; line-height: 1.3;
}
.why-card p { font-size: 14px; color: rgba(255,255,255,.62); margin: 0; line-height: 1.65; }
@media (max-width: 700px) {
  .why-sec { margin: 0 8px; border-radius: 16px; }
  .why-cards { grid-template-columns: 1fr; gap: 14px; }
}
@media (max-width: 700px) {
  .why-sec { padding: 52px 0; }
  .why-sub { font-size: 16px; margin-bottom: 32px; }
  .why-card { padding: 24px 20px; }
  .why-card p { font-size: 15px; }
}
</style>
