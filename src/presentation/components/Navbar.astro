---
import type { SiteProfile } from '../../domain/entities/SiteProfile';
import SiteLinkAnchor from './SiteLinkAnchor.astro';

interface Props {
  site: SiteProfile;
}

const { site } = Astro.props;
---

<nav id="nav">
  <div class="wrap">
    <div class="nav-inner">
      <a class="nav-logo" href="#">
        <div class="logo-mark">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2C8 7 4 10 4 14a8 8 0 0016 0c0-4-4-7-8-12z" fill="white"/>
            <path d="M9 17c0 1.5.9 2.5 2 3" stroke="rgba(255,255,255,.5)" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <div class="logo-text">{site.name}</div>
          <div class="logo-sub">{site.domain}</div>
        </div>
      </a>
      <ul class="nav-links">
        {site.navLinks.map((link) => <li><SiteLinkAnchor link={link} /></li>)}
      </ul>
      <a class="btn-nav" href="#donasi">Wakaf Sekarang →</a>
    </div>
  </div>
</nav>

<style>
/* ── NAVBAR ── */
nav {
  position: sticky;
  top: env(safe-area-inset-top, 0px);
  z-index: 200;
  padding-block: 10px;
  background: var(--bg);
  border-bottom: 1px solid transparent;
  transition: border-color .3s, box-shadow .3s;
}
nav.scrolled {
  border-color: var(--border);
  box-shadow: 0 2px 24px rgba(0,0,0,.07);
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 28px;
}
.nav-logo {
  display: flex; align-items: center; gap: 10px;
  text-decoration: none; color: var(--fg); flex-shrink: 0;
}
.logo-mark {
  width: 38px; height: 38px;
  background: linear-gradient(135deg, var(--blue) 0%, var(--teal) 100%);
  border-radius: 11px;
  display: flex; align-items: center; justify-content: center;
}
.logo-text  { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 15px; line-height: 1.2; }
.logo-sub   { font-size: 10px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-muted); }

.nav-links {
  display: flex; align-items: center; gap: 24px;
  list-style: none; margin: 0; padding: 0; flex: 1;
}
.nav-links :global(a) {
  text-decoration: none; color: var(--fg); font-size: 14px; font-weight: 500;
  opacity: .7; transition: opacity .2s;
}
.nav-links :global(a):hover { opacity: 1; }

.btn-nav {
  margin-left: auto;
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--gold); color: #0A2340;
  font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 14px;
  padding: 10px 22px; border-radius: 100px; text-decoration: none;
  white-space: nowrap; transition: background .2s, transform .15s;
}
.btn-nav:hover { background: #F9C810; transform: translateY(-1px); }

@media (max-width: 680px) {
  .nav-links { display: none; }
  .btn-nav   { padding: 9px 16px; font-size: 13px; }
}
</style>
