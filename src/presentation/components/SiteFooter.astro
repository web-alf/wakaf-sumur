---
import type { SiteProfile } from '../../domain/entities/SiteProfile';
import SiteLinkAnchor from './SiteLinkAnchor.astro';

interface Props {
  site: SiteProfile;
}

const { site } = Astro.props;
---

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img class="footer-logo" src={site.logoUrl} alt={site.name} width="256" height="76" />
        </div>
        <p class="footer-desc">Program wakaf air bersih yang amanah, transparan, dan tersalurkan langsung ke desa yang membutuhkan di seluruh Indonesia.</p>
        <div class="footer-socials">
          {site.socials.map((link) => <SiteLinkAnchor link={link} />)}
        </div>
      </div>
      {
        site.footerColumns.map((column) => (
          <div>
            <div class="footer-col-ttl">{column.title}</div>
            <ul class="footer-links">
              {column.links.map((link) => <li><SiteLinkAnchor link={link} /></li>)}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <div class="footer-copy">© {site.copyrightYear} {site.legalName}. Seluruh hak dilindungi.</div>
      <div class="footer-leg">
        {site.legalLinks.map((link) => <SiteLinkAnchor link={link} />)}
      </div>
    </div>
  </div>
</footer>

<style>
/* ── FOOTER ── */
footer {
  background: var(--blue);
  padding: 56px 0 28px;
}
.footer-grid {
  display: grid; grid-template-columns: 1.6fr 1fr 1fr;
  gap: 36px; margin-bottom: 48px;
}
.footer-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.footer-mark {
  width: 36px; height: 36px; border-radius: 10px;
  background: rgba(255,255,255,.18);
  border: 1.5px solid rgba(255,255,255,.25);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
/* Footer berlatar biru → logo dijadikan putih */
.footer-logo { display: block; height: 44px; width: auto; filter: brightness(0) invert(1); }
.footer-desc { font-size: 13.5px; color: rgba(255,255,255,.75); line-height: 1.65; margin-bottom: 18px; }
.footer-socials { display: flex; gap: 14px; }
.footer-socials :global(a) { font-size: 13px; color: rgba(255,255,255,.6); text-decoration: none; transition: color .2s; }
.footer-socials :global(a):hover { color: #fff; }
.footer-col-ttl {
  font-family:'Space Grotesk',sans-serif; font-size: 12px; font-weight: 700;
  letter-spacing: .1em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px;
}
.footer-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.footer-links :global(a) { font-size: 14px; color: rgba(255,255,255,.7); text-decoration: none; transition: color .2s; }
.footer-links :global(a):hover { color: #fff; }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,.18);
  padding-top: 22px;
  display: flex; align-items: center; justify-content: space-between;
  gap: 14px; flex-wrap: wrap;
}
.footer-copy { font-size: 12.5px; color: rgba(255,255,255,.5); }
.footer-leg { display: flex; gap: 18px; }
.footer-leg :global(a) { font-size: 12.5px; color: rgba(255,255,255,.5); text-decoration: none; transition: color .2s; }
.footer-leg :global(a):hover { color: #fff; }
@media (max-width: 860px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
}
@media (max-width: 500px) {
  .footer-grid { grid-template-columns: 1fr; gap: 24px; }
  .footer-bottom { flex-direction: column; align-items: flex-start; }
}
@media (max-width: 700px) {
  footer { padding: 44px 0 calc(28px + 72px + env(safe-area-inset-bottom, 0px)); }
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 20px 16px; margin-bottom: 32px; }
  .footer-grid > :first-child { grid-column: 1 / -1; }
  .footer-socials { gap: 2px; margin-inline: -10px; }
  .footer-socials :global(a) { display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px; font-size: 14px; color: rgba(255,255,255,.8); }
  .footer-links { gap: 0; }
  .footer-links :global(a) { display: flex; align-items: center; min-height: 44px; font-size: 15px; color: rgba(255,255,255,.85); }
  .footer-leg { flex-wrap: wrap; gap: 0 8px; margin-inline: -6px; }
  .footer-leg :global(a) { display: inline-flex; align-items: center; min-height: 44px; padding: 0 6px; font-size: 13px; color: rgba(255,255,255,.8); }
  .footer-copy { font-size: 13px; color: rgba(255,255,255,.75); }
}
</style>
