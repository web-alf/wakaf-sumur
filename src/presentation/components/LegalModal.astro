---
import type { LegalDocument } from '../../domain/entities/LegalDocument';
import Modal from './Modal.astro';

interface Props {
  document: LegalDocument;
}

const { document: doc } = Astro.props;
---

<Modal id={`modal-${doc.key}`} title={doc.title}>
  <p>Terakhir diperbarui: {doc.lastUpdated}</p>
  {
    doc.sections.map((section) => (
      <div class="modal-section">
        {section.heading && <h3>{section.heading}</h3>}
        {section.blocks.map((block) =>
          block.type === 'paragraph' ? (
            <p set:html={block.text} />
          ) : (
            <ul>
              {block.items.map((item) => <li set:html={item} />)}
            </ul>
          ),
        )}
      </div>
    ))
  }
</Modal>
